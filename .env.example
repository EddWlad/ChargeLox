# Variables de aplicación
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=replace-with-strong-jwt-secret
JWT_EXPIRES_IN=8h

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=chargelox

# Uploads
ACTIVITIES_UPLOAD_DIR=uploads/activities
AVATARS_UPLOAD_DIR=uploads/avatars
CHARGING_POINTS_UPLOAD_DIR=uploads/charging-points
TECHNICAL_EVIDENCE_UPLOAD_DIR=private_uploads/technical-evidences
ACCESS_PERMITS_UPLOAD_DIR=private_uploads/access-permits
MAX_FILE_SIZE_BYTES=5000000
ALLOWED_FILE_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain

# Cloudinary (opcional; usado en evidencias técnicas y avatar)
TECHNICAL_EVIDENCE_STORAGE=auto
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=chargelox/actividades-tecnicas
CLOUDINARY_AVATARS_FOLDER=chargelox/avatars
